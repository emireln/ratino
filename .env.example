APP_NAME=RATINO
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# App Data (MongoDB)
DB_CONNECTION=mongodb
MONGO_DB_HOST=127.0.0.1
MONGO_DB_PORT=27017
MONGO_DB_DATABASE=ratino
MONGO_DB_USERNAME=
MONGO_DB_PASSWORD=

# Background Queues (SQLite)
DB_QUEUE_CONNECTION=sqlite
QUEUE_CONNECTION=database

# Realtime WebSockets (Laravel Reverb)
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=ratino
REVERB_APP_KEY=ratino
REVERB_APP_SECRET=ratino
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

# Cloud Auth & Ledger (Optional Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Storage & Session
SESSION_DRIVER=file
CACHE_STORE=file
FILESYSTEM_DISK=local
CORS_ALLOWED_ORIGINS=
